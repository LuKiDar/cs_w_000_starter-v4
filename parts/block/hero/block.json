{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cs/hero",
	"title": "Hero",
	"description": "A page-opening hero with optional background image, text and buttons.",
	"category": "cs-blocks",
	"icon": "cover-image",
	"keywords": ["hero", "banner", "header", "intro"],
	"acf": {
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"mode": "auto",
		"postTypes": ["page"],
		"renderCallback": "cs__render_hero_block"
	},
	"style": "file:./style.min.css",
	"script": "",
	"editorStyle": "file:./editor.min.css",
	"supports": {
		"align": ["wide", "full"],
		"alignContent": false,
		"alignText": true,
		"anchor": true,
		"html": false,
		"multiple": true,
		"color": {
			"background": true,
			"link": false,
			"text": true
		},
		"spacing": {
			"blockGap": false,
			"margin": ["top", "bottom"],
			"padding": ["top", "bottom"]
		}
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"alignText": {
			"type": "string",
			"default": "center"
		},
		"style": {
			"type": "object",
			"default": {
				"color":{
					"background": "var:preset|color|gray-100"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			}
		}
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"eyebrow": "Welcome",
				"heading": "Page-opening heading",
				"subheading": "A short supporting line.",
				"buttons": [
					{
						"link": {
							"title": "Get started",
							"url": "#"
						},
						"link_type": "button"
					}
				]
			}
		}
	}
}