		"gulp-autoprefixer": "^8.0.0",
		"gulp-clean-css": "^4.3.0",
		"gulp-rename": "^2.0.0",
		"gulp-sass": "^6.0.0",
		"gulp-sourcemaps": "^3.0.0",
		"sass": "^1.85.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0"
	}
}
