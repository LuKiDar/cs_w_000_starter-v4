{
	"name": "cs_w_000_starter-v4",
	"version": "4.0.0",
	"description": "A WordPress starter theme built with a hybrid approach and native Gutenberg blocks.",
	"author": "Crazy Seeker",
	"license": "GPL-3.0",
	"private": true,
	"scripts": {
		"start": "gulp",
		"build": "gulp build",
		"watch": "gulp watch",
		"tokens": "node scripts/build-tokens.mjs",
		"make:block": "node scripts/make-block.mjs",
		"stand": "python scripts/check-theme-stand.py",
		"lint:css": "stylelint \"assets/scss/**/*.scss\" \"parts/block/**/*.scss\" \"!parts/block/_*/**\"",
		"lint:php": "php vendor/bin/phpcs",
		"lint": "npm run lint:css && npm run stand"
	},
	"devDependencies": {
		"browser-sync": "^3.0.3",
		"esbuild": "^0.28.2",
		"glob": "^11.0.1",
